{
  "name": "weave-it",
  "version": "0.1.0",
  "description": "Repo-local LLM wiki and temporary multi-folder AI session tooling.",
  "type": "module",
  "bin": {
    "weave": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "release:bump-skills": "node scripts/bump-skill-versions.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@clack/prompts": "^1.4.0",
    "commander": "^14.0.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.0",
    "tsup": "^8.5.1",
    "tsx": "^4.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
